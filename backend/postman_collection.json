{
  "info": {
    "name": "Campus Compass Backend",
    "description": "CRUD endpoints for Students and Teachers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{baseUrl}}/" }
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Get All Students",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students" }
        },
        {
          "name": "Get Student By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students/STU-2024001" }
        },
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/students",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Student\",\n  \"program\": \"BSCS\",\n  \"department\": \"Computer Science\",\n  \"semester\": 1,\n  \"cgpa\": 3.0,\n  \"attendance\": 90,\n  \"fee\": \"Paid\",\n  \"city\": \"Peshawar\",\n  \"campus\": \"East Campus - Peshawar\",\n  \"status\": \"Active\",\n  \"email\": \"new.student@uni.edu.pk\",\n  \"phone\": \"+92 300 0000000\"\n}"
            }
          }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/students/STU-2024001",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cgpa\": 3.8,\n  \"status\": \"Active\"\n}"
            }
          }
        },
        {
          "name": "Delete Student",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/students/STU-2024001" }
        }
      ]
    },
    {
      "name": "Teachers",
      "item": [
        {
          "name": "Get All Teachers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/teachers" }
        },
        {
          "name": "Get Teacher By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/teachers/FAC-1000" }
        },
        {
          "name": "Create Teacher",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/teachers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Teacher\",\n  \"department\": \"Computer Science\",\n  \"designation\": \"Lecturer\",\n  \"experience\": 2,\n  \"courses\": 1,\n  \"rating\": 4.2,\n  \"salary\": 150000,\n  \"email\": \"new.teacher@uni.edu.pk\",\n  \"status\": \"Active\"\n}"
            }
          }
        },
        {
          "name": "Update Teacher",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/teachers/FAC-1000",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salary\": 350000\n}"
            }
          }
        },
        {
          "name": "Delete Teacher",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/teachers/FAC-1000" }
        }
      ]
    }
  ]
}
